  "globalGroups": [
    {
      "key": 0,
      "name": "开屏广告",
      "desc": "通用开屏广告跳过，匹配常见「跳过」文案与倒计时控件",
      "order": -1,
      "actionMaximum": 2,
      "matchTime": 10000,
      "resetMatch": "app",
      "actionCdKey": 0,
      "actionMaximumKey": 0,
      "rules": [
        {
          "key": 0,
          "matches": "[text*=\"跳过\"][text.length<10][visibleToUser=true]"
        },
        {
          "key": 1,
          "matches": "[childCount=0][visibleToUser=true][(text.length<10&&(text*=\"跳过\"||text*=\"跳過\"||text*=\"skip\"||text*=\"Skip\")) || id$=\"tt_splash_skip_btn\" || vid*=\"skip\" || vid*=\"Skip\" || (vid*=\"count\" && vid*=\"down\" && vid!*=\"download\") || desc*=\"跳过\" || desc*=\"skip\"]"
        },
        {
          "key": 2,
          "matches": "[text*=\"跳过广告\"][text.length<10][visibleToUser=true]"
        },
        {
          "key": 3,
          "matches": "[text^=\"跳过\"][text.length<8][visibleToUser=true][width<300]"
        },
        {
          "key": 4,
          "matches": "[visibleToUser=true][(vid*=\"splash\"&&vid*=\"skip\")||(vid*=\"skip\"&&vid*=\"splash\")]"
        }
      ],
      "apps": [
        {
          "id": "com.android.systemui",
          "enable": false
